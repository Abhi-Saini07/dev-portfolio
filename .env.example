# Public URL of the deployed site — used for canonical links and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where contact-form submissions are POSTed as JSON (server-side only).
# Leave unset and the form will clearly report that delivery isn't configured.
# Examples: a Formspree/Basin endpoint, a Zapier/Make webhook, or your own email function.
CONTACT_WEBHOOK_URL=
